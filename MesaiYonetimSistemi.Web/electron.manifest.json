{
  "executable": "MesaiYonetimSistemi.Web",
  "splashscreen": {
    "imageFile": ""
  },
  "name": "MesaiYonetimSistemi.Web",
  "author": "",
  "singleInstance": false,
  "environment": "Production",
  "build": {
    "appId": "com.MesaiYonetimSistemi.Web.app",
    "productName": "bilim merkezi mesai",
    "icon": "logo.png",
    "copyright": "Copyright © 2020",
    "buildVersion": "1.0.0",
    "compression": "maximum",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Bilim Merkezi Mesai"
    },
    "directories": {
      "output": "../../../bin/Desktop"
    },
    "extraResources": [
      {
        "from": "./bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      {
        "from": "./ElectronHostHook/node_modules",
        "to": "ElectronHostHook/node_modules",
        "filter": [
          "**/*"
        ]
      },
      "**/*"
    ]
  }
}