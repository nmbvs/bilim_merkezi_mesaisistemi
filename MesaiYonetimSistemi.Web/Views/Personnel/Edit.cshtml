@model MesaiYonetimSistemi.Application.DTOs.UpdateUserDto
@{
    ViewData["Title"] = "Personel Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card-custom p-4">
            <h5 class="font-weight-bold mb-4"><i class="fa-solid fa-user-pen text-primary me-2"></i> Personel Bilgilerini Güncelle</h5>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Ad Soyad</label>
                        <input type="text" asp-for="AdSoyad" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Sicil No</label>
                        <input type="text" asp-for="SicilNo" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">TC Kimlik No</label>
                        <input type="text" asp-for="TcKimlikNo" class="form-control" maxlength="11" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">E-posta Adresi (Giriş Adresi)</label>
                        <input type="email" asp-for="Email" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Telefon Numarası</label>
                        <input type="text" asp-for="PhoneNumber" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Departman</label>
                        <input type="text" asp-for="Departman" class="form-control" list="departmentsDl" required autocomplete="off" onclick="if(this.showPicker) this.showPicker();" placeholder="Kayıtlılardan seçin veya yeni yazın..." />
                        <datalist id="departmentsDl">
                            @if (ViewBag.Departments != null)
                            {
                                @foreach (var d in (List<string>)ViewBag.Departments)
                                {
                                    <option value="@d"></option>
                                }
                            }
                        </datalist>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Görev / Unvan</label>
                        <input type="text" asp-for="Gorev" class="form-control" list="gorevlerDl" autocomplete="off" onclick="if(this.showPicker) this.showPicker();" placeholder="Kayıtlılardan seçin veya yeni yazın..." />
                        <datalist id="gorevlerDl">
                            @if (ViewBag.Gorevler != null)
                            {
                                @foreach (var g in (List<string>)ViewBag.Gorevler)
                                {
                                    <option value="@g"></option>
                                }
                            }
                        </datalist>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Şube</label>
                        <input type="text" asp-for="Sube" class="form-control" list="subelerDl" autocomplete="off" onclick="if(this.showPicker) this.showPicker();" placeholder="Kayıtlılardan seçin veya yeni yazın..." />
                        <datalist id="subelerDl">
                            @if (ViewBag.Subeler != null)
                            {
                                @foreach (var s in (List<string>)ViewBag.Subeler)
                                {
                                    <option value="@s"></option>
                                }
                            }
                        </datalist>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">İşe Giriş Tarihi</label>
                        <input type="date" asp-for="IseGirisTarihi" class="form-control" value="@Model.IseGirisTarihi.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Rol</label>
                        <select asp-for="Role" class="form-select">
                            <option value="Personel">Personel</option>
                            <option value="Yonetici">Yönetici</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check mt-4">
                            <input type="checkbox" asp-for="AktifMi" class="form-check-input" id="aktifCheck" />
                            <label class="form-check-label text-muted small" for="aktifCheck">Aktif Personel</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light">İptal</a>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i> Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>
