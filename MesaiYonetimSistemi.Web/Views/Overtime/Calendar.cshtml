@{
    ViewData["Title"] = "Mesai Takvim Görünümü";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="font-weight-bold m-0"><i class="fa-solid fa-calendar-alt text-primary me-2"></i>Hafta Sonu Mesai Takvimi</h4>
        <p class="text-muted small m-0">Takvim üzerinde planlanan, atanan ve tamamlanan tüm mesaileri detaylıca görüntüleyin.</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-success px-3 py-2"><i class="fa-solid fa-circle me-1"></i> Atanmış Mesai</span>
        <span class="badge bg-warning text-dark px-3 py-2"><i class="fa-solid fa-circle me-1"></i> Bekleyen / Açık Mesai</span>
        <span class="badge bg-danger px-3 py-2"><i class="fa-solid fa-circle me-1"></i> İzinli Personel</span>
    </div>
</div>

<div class="card-custom p-3 p-md-4 shadow-sm">
    <div id="calendar" class="fc-responsive"></div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendar');
            var eventsData = @Html.Raw(ViewBag.CalendarEventsJson ?? "[]");

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: window.innerWidth < 768 ? 'listMonth' : 'dayGridMonth',
                locale: 'tr',
                buttonText: {
                    today: 'Bugün',
                    month: 'Ay',
                    week: 'Hafta',
                    list: 'Liste'
                },
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: window.innerWidth < 768 ? 'dayGridMonth,listMonth' : 'dayGridMonth,timeGridWeek,listMonth'
                },
                events: eventsData,
                height: 'auto',
                contentHeight: 650,
                expandRows: true,
                handleWindowResize: true,
                eventClick: function(info) {
                    var props = info.event.extendedProps || {};
                    var deptInfo = (props.departman && props.departman !== '-') ? `${props.departman} ${props.sube ? '(' + props.sube + ')' : ''}` : '';
                    
                    var htmlContent = `
                        <div class="text-start mt-2">
                            <p class="mb-2"><strong><i class="fa-solid fa-calendar-day me-1 text-primary"></i> Başlık:</strong> ${info.event.title}</p>
                            ${props.personel ? `<p class="mb-2"><strong><i class="fa-solid fa-user me-1 text-info"></i> İlgili Personel:</strong> ${props.personel}</p>` : ''}
                            ${props.durum ? `<p class="mb-2"><strong><i class="fa-solid fa-info-circle me-1 text-warning"></i> Durum:</strong> ${props.durum}</p>` : ''}
                            ${deptInfo ? `<p class="mb-2"><strong><i class="fa-solid fa-building me-1 text-secondary"></i> Birim / Şube:</strong> ${deptInfo}</p>` : ''}
                            <p class="mb-2"><strong><i class="fa-solid fa-clock me-1 text-success"></i> Başlangıç:</strong> ${info.event.start ? info.event.start.toLocaleString('tr-TR') : '-'}</p>
                            <p class="mb-2"><strong><i class="fa-solid fa-flag-checkered me-1 text-danger"></i> Bitiş:</strong> ${info.event.end ? info.event.end.toLocaleString('tr-TR') : '-'}</p>
                            <p class="mb-0"><strong><i class="fa-solid fa-align-left me-1 text-muted"></i> Açıklama:</strong> ${props.description || 'Detay girilmedi.'}</p>
                        </div>
                    `;

                    Swal.fire({
                        title: 'Takvim Etkinlik Detayı',
                        html: htmlContent,
                        icon: 'info',
                        confirmButtonText: 'Tamam',
                        confirmButtonColor: '#4f46e5'
                    });
                }
            });
            calendar.render();

            window.addEventListener('resize', function () {
                if (window.innerWidth < 768) {
                    calendar.changeView('listMonth');
                }
            });
        });
    </script>
}
