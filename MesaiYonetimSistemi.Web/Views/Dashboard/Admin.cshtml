@model MesaiYonetimSistemi.Application.DTOs.DashboardDto
@{
    ViewData["Title"] = "Yönetici Dashboard";
}

<!-- Stat Cards Row -->
<div class="row g-3 mb-4">
    <div class="col-xl-4 col-md-6">
        <div class="stat-card">
            <div>
                <span class="text-muted small d-block mb-1">Toplam Aktif Personel</span>
                <h3 class="font-weight-bold m-0">@Model.TotalPersonnelCount</h3>
            </div>
            <div class="stat-icon primary">
                <i class="fa-solid fa-users"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-6">
        <div class="stat-card">
            <div>
                <span class="text-muted small d-block mb-1">Planlanan Mesailer</span>
                <h3 class="font-weight-bold m-0">@Model.ActiveOvertimesCount</h3>
            </div>
            <div class="stat-icon warning">
                <i class="fa-solid fa-clock"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-6">
        <div class="stat-card">
            <div>
                <span class="text-muted small d-block mb-1">Yanıt Bekleyen Teklifler</span>
                <h3 class="font-weight-bold m-0">@Model.PendingOffersCount</h3>
            </div>
            <div class="stat-icon info">
                <i class="fa-solid fa-envelope-open-text"></i>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card-custom p-4">
            <h6 class="font-weight-bold mb-3"><i class="fa-solid fa-chart-bar text-primary me-2"></i> Aylık Mesai Dağılımı</h6>
            <div style="height: 280px;">
                <canvas id="monthlyChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card-custom p-4">
            <h6 class="font-weight-bold mb-3"><i class="fa-solid fa-chart-pie text-primary me-2"></i> Departman Bazlı Personel Dağılımı</h6>
            <div style="height: 280px;">
                <canvas id="deptChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Overtimes & Pending Offers Row -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card-custom p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="font-weight-bold m-0"><i class="fa-solid fa-calendar-days text-primary me-2"></i> Son Hafta Sonu Mesaileri</h6>
                <a asp-controller="Overtime" asp-action="Create" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus me-1"></i> Yeni Mesai Oluştur</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Saat</th>
                            <th>Departman</th>
                            <th>Şube</th>
                            <th>Atanan Personel</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentOvertimes.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">Henüz kayıtlı mesai bulunmuyor.</td></tr>
                        }
                        @foreach (var ot in Model.RecentOvertimes)
                        {
                            <tr>
                                <td><strong>@ot.Tarih.ToString("dd.MM.yyyy")</strong></td>
                                <td>@ot.BaslangicSaati.ToString(@"hh\:mm") - @ot.BitisSaati.ToString(@"hh\:mm")</td>
                                <td>@ot.Departman</td>
                                <td>@ot.Sube</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(ot.AtananUserAdSoyad))
                                    {
                                        <span class="fw-semibold text-success"><i class="fa-solid fa-user-check me-1"></i>@ot.AtananUserAdSoyad</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning"><i class="fa-solid fa-spinner fa-spin me-1"></i>Teklif Aşamasında</span>
                                    }
                                </td>
                                <td>
                                    @if (ot.Durum == "Planlandi") { <span class="badge badge-bekliyor">Planlandı</span> }
                                    else if (ot.Durum == "Tamamlandi") { <span class="badge badge-kabul">Tamamlandı</span> }
                                    else { <span class="badge badge-red">İptal</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card-custom p-4">
            <h6 class="font-weight-bold mb-3"><i class="fa-solid fa-bullhorn text-primary me-2"></i> Duyurular</h6>
            <div class="list-group list-group-flush">
                @if (!Model.RecentAnnouncements.Any())
                {
                    <p class="text-muted small">Aktif duyuru yok.</p>
                }
                @foreach (var ann in Model.RecentAnnouncements)
                {
                    <div class="list-group-item px-0">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="small text-truncate">@ann.Baslik</strong>
                            <small class="text-muted" style="font-size:0.75rem;">@ann.OlusturmaTarihi.ToString("dd.MM")</small>
                        </div>
                        <p class="small text-muted m-0 text-truncate">@ann.Icerik</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Department Chart
            const deptCtx = document.getElementById('deptChart').getContext('2d');
            const deptLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartmentDistribution.Keys));
            const deptData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartmentDistribution.Values));

            new Chart(deptCtx, {
                type: 'doughnut',
                data: {
                    labels: deptLabels,
                    datasets: [{
                        data: deptData,
                        backgroundColor: ['#4f46e5', '#10b981', '#f59e0b', '#06b6d4', '#ec4899']
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });

            // Monthly Chart
            const monthlyCtx = document.getElementById('monthlyChart').getContext('2d');
            const monthlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyOvertimeStats.Keys));
            const monthlyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyOvertimeStats.Values));

            new Chart(monthlyCtx, {
                type: 'bar',
                data: {
                    labels: monthlyLabels,
                    datasets: [{
                        label: 'Mesai Sayısı',
                        data: monthlyData,
                        backgroundColor: '#4f46e5',
                        borderRadius: 6
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });
        });
    </script>
}
