@model MesaiYonetimSistemi.Application.DTOs.ChangePasswordDto
@{
    ViewData["Title"] = "Şifre Değiştir";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card-custom p-4">
            <h5 class="font-weight-bold mb-3"><i class="fa-solid fa-lock text-primary me-2"></i> Şifre Değiştir</h5>
            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label text-muted small">Mevcut Şifre</label>
                    <input type="password" asp-for="CurrentPassword" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">Yeni Şifre</label>
                    <input type="password" asp-for="NewPassword" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">Yeni Şifre (Tekrar)</label>
                    <input type="password" asp-for="ConfirmNewPassword" class="form-control" required />
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Profile" class="btn btn-light">İptal</a>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-2"></i> Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>
